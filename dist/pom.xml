<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.technoade</groupId>
        <artifactId>technoblocks-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>technoblocks-dist</artifactId>

    <dependencies>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- adapters -->
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_19_R2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_19_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_18_R2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_17_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_16_R3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_15_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_14_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_13_R2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_12_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_11_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_10_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_9_R2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>it.technoade</groupId>
            <artifactId>technoblocks-nms-v1_8_R3</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>TechnoBlocks-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>it.technoade:*</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
